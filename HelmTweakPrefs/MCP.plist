<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>items</key>
	<array>
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>label</key>
			<string>MCP 工具（基于 ios-mcp）</string>
			<key>footerText</key>
			<string>以下配置写入 com.witchan.ios-mcp.preferences 域，ios-mcp 主 dylib 监听 darwin notification 自动响应。默认关闭，开启后立即启动 MCP server。</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>label</key>
			<string>服务开关</string>
		</dict>
		<dict>
			<key>action</key>
			<string>setMCPEnabled:</string>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>default</key>
			<false/>
			<key>defaults</key>
			<string>com.witchan.ios-mcp.preferences</string>
			<key>key</key>
			<string>enabled</string>
			<key>label</key>
			<string>启用 MCP 服务</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>label</key>
			<string>HTTP 端口</string>
			<key>footerText</key>
			<string>默认端口 8686。范围 1024-65535。服务运行时改端口自动切换。</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSEditTextCell</string>
			<key>default</key>
			<integer>8686</integer>
			<key>defaults</key>
			<string>com.witchan.ios-mcp.preferences</string>
			<key>id</key>
			<string>httpPortField</string>
			<key>keyboardType</key>
			<string>numberPad</string>
			<key>key</key>
			<string>port</string>
			<key>label</key>
			<string>端口</string>
			<key>placeholder</key>
			<string>8686</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>label</key>
			<string>Debug 日志</string>
			<key>footerText</key>
			<string>开启后服务启动/HTTP 请求/MCP 工具调用/耗时/错误写入文件，便于排查。</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>default</key>
			<false/>
			<key>defaults</key>
			<string>com.witchan.ios-mcp.preferences</string>
			<key>key</key>
			<string>debugLoggingEnabled</string>
			<key>label</key>
			<string>启用 Debug 日志</string>
		</dict>
	</array>
	<key>title</key>
	<string>MCP</string>
</dict>
</plist>
